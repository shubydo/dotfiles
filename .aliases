# General

alias reload="exec zsh"
# sourcing does not terminate running processes began
# alias reload="source $HOME/.zshrc"

# Editor (set in .zshrc)
alias v="\$EDITOR" # muscle memory

# Config
alias zshrc="\$EDITOR \$HOME/.zshrc"
alias aliases="\$EDITOR \$HOME/.aliases"
alias omzconfig="\$EDITOR \$HOME/.oh-my-zsh"

# github.com/shubydo/kickstart.nvim
alias nvim-kickstart='NVIM_APPNAME="nvim-kickstart" nvim'

# Mac specific

# Only alias when GNU sed is installed (brew install gnu-sed); otherwise `sed` breaks entirely
if command -v gsed >/dev/null; then
  alias sed="gsed"
fi

# git

alias ga="git add"
alias glog="git log"
alias gcan="git commit --amend --no-edit"
alias gcm="git commit -m"
alias gs="git status"

# asdf
# GOROOT re-shim fix: <https://github.com/kennyp/asdf-golang/issues/28#issuecomment-726189750>
alias go-reshim="asdf reshim golang && reload"